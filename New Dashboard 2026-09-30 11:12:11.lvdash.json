{
  "datasets": [
    {
      "name": "8b0334d5",
      "displayName": "Total Unique Patients Count Summary",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(DISTINCT Id) AS total_patients\r\n",
        "FROM workspace.default.patients;"
      ]
    },
    {
      "name": "a458cb1b",
      "displayName": "Total Unique Ecounters",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(DISTINCT Id) AS total_encounters\r\n",
        "FROM workspace.default.encounters;"
      ]
    },
    {
      "name": "718e633e",
      "displayName": "Patient Encounter Overview Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    Id,\r\n",
        "    PATIENT,\r\n",
        "    ENCOUNTERCLASS\r\n",
        "FROM workspace.default.encounters\r\n",
        "LIMIT 10;\r\n"
      ]
    },
    {
      "name": "3e8cbf0e",
      "displayName": "Average Ecounter by each patient",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        COUNT(DISTINCT Id) / COUNT(DISTINCT PATIENT),\r\n",
        "        2\r\n",
        "    ) AS encounters_per_patient\r\n",
        "FROM encounters;"
      ]
    },
    {
      "name": "3459f120",
      "displayName": "Encounter Class Distribution Summary Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    DISTINCT ENCOUNTERCLASS,\r\n",
        "    COUNT(*) AS Count\r\n",
        "FROM encounters\r\n",
        "GROUP BY ENCOUNTERCLASS\r\n",
        "ORDER BY Count DESC;\r\n"
      ]
    },
    {
      "name": "de72438f",
      "displayName": "Encounter Trend Over Time",
      "queryLines": [
        "SELECT\r\n",
        "    YEAR(START) AS encounter_year,\r\n",
        "    COUNT(DISTINCT Id) AS encounter_count\r\n",
        "FROM encounters\r\n",
        "GROUP BY YEAR(START)\r\n",
        "ORDER BY encounter_year;\r\n",
        "\r\n"
      ]
    },
    {
      "name": "4b16e3a9",
      "displayName": "Yearly Encounter Counts by Classification Summary",
      "queryLines": [
        "SELECT\r\n",
        "    YEAR(START) AS encounter_year,\r\n",
        "    ENCOUNTERCLASS AS encounter_class,\r\n",
        "    COUNT(DISTINCT Id) AS encounter_count\r\n",
        "FROM encounters\r\n",
        "WHERE YEAR(START) BETWEEN 2020 AND 2026\r\n",
        "GROUP BY\r\n",
        "    YEAR(START),\r\n",
        "    ENCOUNTERCLASS\r\n",
        "ORDER BY\r\n",
        "    encounter_year;"
      ]
    },
    {
      "name": "4f21b8c0",
      "displayName": "Providers and their count encounters",
      "queryLines": [
        "SELECT\r\n",
        "    PROVIDER,\r\n",
        "    COUNT(DISTINCT Id) AS encounter_count\r\n",
        "FROM encounters\r\n",
        "GROUP BY PROVIDER\r\n",
        "ORDER BY encounter_count DESC\r\n",
        "LIMIT 5;"
      ]
    },
    {
      "name": "bf8605d5",
      "displayName": "Encounter Counts Grouped by Organization",
      "queryLines": [
        "SELECT\r\n",
        "    ORGANIZATION,\r\n",
        "    COUNT(DISTINCT Id) AS encounter_count\r\n",
        "FROM encounters\r\n",
        "GROUP BY ORGANIZATION\r\n",
        "ORDER BY encounter_count DESC\r\n",
        "limit 10;"
      ]
    },
    {
      "name": "079de84a",
      "displayName": "encounter types tend to last the longest",
      "queryLines": [
        "SELECT\r\n",
        "    ENCOUNTERCLASS,\r\n",
        "    ROUND(\r\n",
        "        AVG(TIMESTAMPDIFF(MINUTE, START, STOP)),\r\n",
        "        2\r\n",
        "    ) AS avg_duration_minutes\r\n",
        "FROM encounters\r\n",
        "WHERE START IS NOT NULL\r\n",
        "  AND STOP IS NOT NULL\r\n",
        "GROUP BY ENCOUNTERCLASS\r\n",
        "ORDER BY avg_duration_minutes DESC;"
      ]
    }
  ],
